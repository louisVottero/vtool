QTextEdit {
    background-color: #171717;
    color: #CFCFCF;
    padding: 0.05em;
    selection-color: white;
    selection-background-color: --highlight;
    font-size: 8.5pt;
}

QPushButton {
    background-color: #5B5B5B;
    color: #EFEFEF;
    padding: 0.03em 0.2em;
    border-radius: 0.1em;
    min-height: 0.05em;
    max-height: 1.25em;
    font-size: 8.5pt;
}

QPushButton:pressed {
    color: white;
    background-color: black;
}

QPushButton:checked {
    color: black;
    background-color: --highlight;
}

QPushButton:hover {
    color: white;
    background-color: #6C6C6C;
}

QPushButton:checked:hover {
    color: grey;
    background-color: --highlight;
}

QSpinBox, QDoubleSpinBox {
    background: --highlight;
    color: black;
    border-radius: 0.1em;
    border: 1px solid #555555;
    padding: 0.05em 0.14em;
    min-height: 1.0em;
    font-size: 8.5pt;
}

QGroupBox {
    background-color: #5D5D5D;
    border: 0px;
    font-size: 8.5pt;
}

QCheckBox {
    background: #444444;
    border: 0px;
    spacing: 0.18em;
    font-size: 8.5pt;
}

QCheckBox::indicator {
    background-color: --highlight;
    border-radius: 0.1em;
    width: 0.78em;
    height: 0.78em;
}

QCheckBox::indicator:checked {
    image: url(--icon_path/check.png);
}

QSplitter::handle:horizontal {
    width: 0.1em;
}

QSplitter::handle:vertical {
    height: 0.1em;
}

QListView, QTreeView {
    background-color: #383838;
    alternate-background-color: #353535;
    font-size: 8.5pt;
}

QTreeView {
    show-decoration-selected: 1;
}

QTreeView::item:hover {
    background-color: #494949;
}

QTreeView::item:selected {
    color: black;
    background: --highlight;
}

QTreeView::item:selected:active {
    background: --highlight;
    color: black;
}

QTreeView::item:selected:!active {
    background: --highlight;
    color: black;
}

QTreeView::branch:selected:active {
    background-color: --highlight;
}

QTreeView::branch:selected:!active {
    background-color: --highlight;
}

QTreeWidget::indicator:unchecked {
    image: url(--icon_path/box_off.png);
}

QTreeWidget::indicator:checked {
    image: url(--icon_path/box_on.png);
}

ProcessTreeWidget::indicator:unchecked {
    image: url(--icon_path/minus_alt.png);
}

ProcessTreeWidget::indicator:checked {
    image: url(--icon_path/plus.png);
}

/* ========== Compact Tabs ========== */

QTabWidget::pane {
    border-top: 1px solid #3A3A3A;
    background: #3D3D3D;
}

QTabWidget::tab-bar {
    left: 0.08em;
}

QTabBar {
    border: 0px;
    padding-top: 0.04em;
    background: transparent;
}

QTabBar::tab {
    background-color: #2F2F2F;
    color: #B0B0B0;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    min-width: 4.4em;
    padding: 0.07em 0.4em;
    margin-right: 0.05em;
    border-top-left-radius: 0.1em;
    border-top-right-radius: 0.1em;
    font-size: 8.5pt;
    height: 0.95em;
    white-space: nowrap;
}

QTabBar::tab:hover {
    background-color: #3A3A3A;
    color: #E0E0E0;
    border-color: #4A4A4A;
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 --darkhighlight,
        stop:0.28 --darkhighlight,
        stop:0.55 #2F2F2F,
        stop:1 #2F2F2F
    );
    color: #B0B0B0;
    border: 1px solid #3A3A3A;
    border-top: 0.1em solid --highlight;
    border-bottom: 0px solid;
    margin-top: 0.03em;
    font-size: 8.5pt;
}

QTabBar::tab:!selected {
    margin-top: 0.03em;
}

/* ========== End Tabs ========== */

/* ========== Consistent Scrollbars ========== */

QAbstractScrollArea {
    border-radius: 0.1em;
    background-color: #303030;
}

QAbstractScrollArea::corner {
    border: none;
    background-color: transparent;
}

QScrollBar {
    border: none;
    background-color: #303030;
}

/* Vertical scrollbar */
QScrollBar:vertical {
    width: 0.35em;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: --highlightdark;
    border-radius: 0.2em;          /* nicely rounded */
    min-height: 1.2em;
    margin: 0.08em 0.05em;         /* keeps it centered */
}

QScrollBar::handle:vertical:hover {
    background-color: --highlight;
    border-radius: 0.25em;
    min-height: 1.2em;
    width: 0.7em;                  /* grows on hover */
    margin: 0.08em 0px;            /* still centered after growth */
}

/* Horizontal scrollbar */
QScrollBar:horizontal {
    height: 0.35em;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: --highlightdark;
    border-radius: 0.2em;          /* nicely rounded */
    min-width: 1.2em;
    margin: 0.05em 0.08em;         /* keeps it centered */
}

QScrollBar::handle:horizontal:hover {
    background-color: --highlight;
    border-radius: 0.25em;
    min-width: 1.2em;
    height: 0.7em;                 /* grows on hover */
    margin: 0px 0.08em;            /* still centered after growth */
}

/* Remove arrows */
QScrollBar::sub-line,
QScrollBar::add-line {
    height: 0px;
    width: 0px;
}

/* Transparent pages so background shows through cleanly */
QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
}

