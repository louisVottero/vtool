QHeaderView {
    border: 0px;
    background-color: #2D2D2D;
}

QHeaderView::section {
    background-color: #373737;
    color: #C0C0C0;
    border: 0px solid #4A4A4A;
    padding: 0.06em 0.22em;
    border-radius: 0.1em;
    font-weight: bold;
    font-size: 8.5pt;
}

QHeaderView::section:hover {
    background-color: #4D4D4D;
    color: #EBEBEB;
}

QHeaderView::down-arrow {
    image: url(--icon_path/arrow_down.png);
    width: 0.7em;
    height: 0.7em;
    subcontrol-position: center right;
    padding-right: 0.1em;
}

QHeaderView::up-arrow {
    image: url(--icon_path/arrow_up.png);
    width: 0.7em;
    height: 0.7em;
    subcontrol-position: center right;
    padding-right: 0.1em;
}

QWidget {
    background-color: #3D3D3D;
    color: #C0C0C0;
    border: 0px solid #5F5F5F;
    font-size: 8.5pt;
}

QFrame, QLabel, QToolTip {
    background: transparent;
    color: #C0C0C0;
    border: 0px solid #5A5A5A;
    border-radius: 0px;
    padding: 0px;
    font-size: 8.5pt;
}

QFrame {
    background: transparent;
    padding: 0.03em;
}

QLabel {
    border: 0px;
    padding: 0.03em 0.08em;
}

QToolTip {
    background: #4D4D4D;
    color: #E0E0E0;
    border: 1px solid #5A5A5A;
    padding: 0.1em 0.22em;
}

QLineEdit {
    background-color: #202020;
    color: #EBEBEB;
    selection-color: black;
    selection-background-color: --highlight;
    border-radius: 0.1em;
    border: 1px solid #4A4A4A;
    padding: 0.05em 0.14em;
    min-height: .75em;
    font-size: 8.5pt;
}

QTextEdit {
    background-color: #1A1A1A;
    color: #EBEBEB;
    padding: 0.05em;
    selection-color: black;
    selection-background-color: --highlight;
    font-size: 8.5pt;
}

QPushButton {
    background-color: #585858;
    color: #FFFFFF;
    padding: 0.03em 0.1em;
    border-radius: 0.1em;
    min-height: 0.05em;
    max-height: 1.25em;
    font-size: 8.5pt;
}

QPushButton:pressed {
    color: white;
    background-color: #1A1A1A;
}

QPushButton:checked {
    color: black;
    background-color: --highlight;
}

QPushButton:hover {
    color: white;
    background-color: #656565;
}

QPushButton:checked:hover {
    color: black;
    background-color: --highlight;
}

QSpinBox, QDoubleSpinBox {
    background: #232323;
    color: #EBEBEB;
    border-radius: 0.1em;
    border: 1px solid #4A4A4A;
    padding: 0.02em 0.1em;
    min-height: 0.9em;
    font-size: 8.5pt;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 0.8em;
    background-color: #2D2D2D;
    border: none;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #373737;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 0.5em;
    height: 0.5em;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 0.8em;
    background-color: #2D2D2D;
    border: none;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #373737;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 0.5em;
    height: 0.5em;
}

QCheckBox {
    background: transparent;
    border: 0px;
    spacing: 0.18em;
    font-size: 8.5pt;
}

QCheckBox::indicator {
    background-color: --highlight;
    border-radius: 0.1em;
    width: 0.78em;
    height: 0.78em;
}

QCheckBox::indicator:checked {
    image: url(--icon_path/check.png);
}

QSplitter::handle:horizontal {
    width: .3em;
}

QSplitter::handle:vertical {
    height: .3em;
}

QListView, QTreeView {
    background-color: #373737;
    alternate-background-color: #3D3D3D;
    font-size: 8.5pt;
    spacing: 0px;
}

QListView, QTreeView {
    background-color: #373737;
    alternate-background-color: #3D3D3D;
    font-size: 8.5pt;
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    
}

QTreeView {
    show-decoration-selected: 1;
    itemsExpandable: true;
    indentation: 0.3em;
    uniformRowHeights: true;    
}

QTreeView::item {
    padding: 0.02em 0.05em;
    height: 1.0em; 
    margin: 0px;
}

QTreeView::item:hover {
    background-color: #4D4D4D;
}

QTreeView::item:selected {
    color: black;
    background: --highlight;
}

QTreeView::item:selected:active {
    background: --highlight;
    color: black;
}

QTreeView::item:selected:!active {
    background: --highlight;
    color: black;
}

QTreeView::branch:selected:active {
    background-color: --highlight;
}

QTreeView::branch:selected:!active {
    background-color: --highlight;
}

QTreeWidget::indicator:unchecked {
    image: url(--icon_path/box_off.png);
}

QTreeWidget::indicator:checked {
    image: url(--icon_path/box_on.png);
}

ProcessTreeWidget::indicator:unchecked {
    image: url(--icon_path/minus_alt.png);
}

ProcessTreeWidget::indicator:checked {
    image: url(--icon_path/plus.png);
}

QTabWidget::pane {
    border-top: 1px solid #3A3A3A;
    background: #373737;
}

QTabWidget::tab-bar {
    left: 0.08em;
}

QTabBar {
    border: 0px;
    padding-top: 0.04em;
    background: transparent;
}

QTabBar::tab {
    background-color: #323232;
    color: #C0C0C0;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    min-width: 4.4em;
    padding: 0.07em 0.4em;
    margin-right: 0.05em;
    border-top-left-radius: 0.1em;
    border-top-right-radius: 0.1em;
    font-size: 8.5pt;
    height: 0.95em;
    white-space: nowrap;
}

QTabBar::tab:hover {
    background-color: #4D4D4D;
    color: #EBEBEB;
    border-color: #4A4A4A;
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 --darkhighlight,
        stop:0.28 --darkhighlight,
        stop:0.55 #3D3D3D,
        stop:1 #3D3D3D
    );
    color: #C0C0C0;
    border: 1px solid #3A3A3A;
    border-top: 0.1em solid --highlight;
    border-bottom: 0px solid;
    margin-top: 0.03em;
    font-size: 8.5pt;
}

QTabBar::tab:!selected {
    margin-top: 0.03em;
}

QAbstractScrollArea {
    border-radius: 0.1em;
    background-color: #373737;
}

QAbstractScrollArea::corner {
    border: none;
    background-color: transparent;
}

QScrollBar {
    border: none;
    background-color: #373737;
}

QScrollBar:vertical {
    width: 0.35em;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: --highlightdark;
    border-radius: 0.1em;         
    min-height: 1.2em;
    margin: 0.08em 0.05em;        
}

QScrollBar::handle:vertical:hover {
    background-color: --highlight;
    border-radius: 0.15em;
    min-height: 1.2em;
    width: 0.7em;                 
    margin: 0.08em 0px;           
}

QScrollBar:horizontal {
    height: 0.35em;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: --highlightdark;
    border-radius: 0.1em;         
    min-width: 1.2em;
    margin: 0.05em 0.08em;        
}

QScrollBar::handle:horizontal:hover {
    background-color: --highlight;
    border-radius: 0.15em;
    min-width: 1.2em;
    height: 0.7em;                
    margin: 0px 0.08em;           
}

QScrollBar::sub-line,
QScrollBar::add-line {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
}

QPlainTextEdit {
    background-color: #1A1A1A;
    font-size: 8.5pt;
}

QMenu {
    background-color: #4D4D4D;
    border: 1px solid #3D3D3D;
    color: #E0E0E0;
    border-radius: 0.1em;
    padding: 0.05em;
    font-size: 8.5pt;
}

QMenu::item {
    padding: 0.09em 0.4em;
    background-color: transparent;
    color: #EBEBEB;
}

QMenu::item:hover {
    background-color: #585858;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: --highlight;
    color: #000000;
    border-radius: 0.08em;
}

QMenu::separator {
    height: 1px;
    background-color: #4A4A4A;
    margin: 0.05em 0;
}

ProcessOptionsWidget {
    background-color: #454545;
}

ProcessOptionGroup QLabel {
    border: 1px;
    padding: 0.03em 0.08em;
    background-color: transparent;
    font-size: 8.5pt;
}

ProcessOptionGroup QCheckBox {
    border: 0px;
    padding: 0px;
    background-color: transparent;
    font-size: 8.5pt;
}

ProcessOptionGroup OptionGroup {
    background-color: #3D3D3D;
}

ProcessOptionGroup OptionGroup QLabel {
    background-color: transparent;
}

ProcessOptionGroup OptionGroup QCheckBox {
    background: transparent;
}

ProcessOptionGroup OptionGroup OptionGroup {
    background-color: #373737;
}

ProcessOptionGroup OptionGroup OptionGroup QLabel {
    background-color: transparent;
}

ProcessOptionGroup OptionGroup OptionGroup QCheckBox {
    background: transparent;
}

ProcessOptionGroup OptionGroup OptionGroup OptionGroup {
    background-color: #323232;
}

ProcessOptionGroup OptionGroup OptionGroup OptionGroup QLabel {
    background-color: transparent;
}

ProcessOptionGroup OptionGroup OptionGroup OptionGroup QCheckBox {
    background: transparent;
}

QGroupBox {
    background-color: #373737;
    border: 1px solid #4A4A4A;
    border-radius: 0.1em;
    padding: 0.1em 0.1em;
    margin-top: 0.3em;
    font-size: 8.5pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0.1em;
    padding: 0em 0.2em;
    color: #C0C0C0;
    font-weight: bold;
    font-size: 8.5pt;
}

Group {
    background-color: #373737;
    border: 1px solid #4A4A4A;
    border-radius: 0.1em;
    padding: 0em 0em;
    margin-top: 0.3em;
    font-size: 8.5pt;
}

Group::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0.3em;
    padding: 0em 0.2em;
    color: #C0C0C0;
    font-weight: bold;
    font-size: 8.5pt;
}

Group[collapsed="true"] {
    background-color: #323232;
    border: 1px solid #2D2D2D;
    padding: 0em 0em;
    margin-top: 0.08em;
}

QRadioButton {
    background: transparent;
    border: 0px;
    spacing: 0.18em;
    font-size: 8.5pt;
}

QRadioButton::indicator {
    width: 0.78em;
    height: 0.78em;
    border-radius: 0.4em;
    border: 1px solid #4A4A4A;
}

QRadioButton::indicator:unchecked {
    background-color: #202020;
}

QRadioButton::indicator:checked {
    background-color: --highlight;
    background-image: radial-gradient(circle, --highlight 0%, --highlight 35%, transparent 70%);
}

QRadioButton::indicator:hover {
    border: 1px solid #5A5A5A;
    background-color: #282828;
}

QRadioButton::indicator:checked:hover {
    background-color: --highlight;
}

QRadioButton::indicator:disabled {
    background-color: #323232;
    border: 1px solid #3A3A3A;
}
