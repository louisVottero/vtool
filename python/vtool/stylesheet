QHeaderView {
    border: 0px;
    background-color: #2F2F2F;
}

QHeaderView::section {
    background-color: #383838;
    color: #B0B0B0;
    border: 1px solid #4A4A4A;
    padding: 3px 6px;
    border-radius: 2px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #454545;
    color: #D0D0D0;
}

QHeaderView::down-arrow {
    image: url(--icon_path/arrow_down.png);
    width: 14px;
    height: 14px;
    subcontrol-position: center right;
    padding-right: 3px;
}

QHeaderView::up-arrow {
    image: url(--icon_path/arrow_up.png);
    width: 14px;
    height: 14px;
    subcontrol-position: center right;
    padding-right: 3px;
}

QWidget {
    background-color: #444444;
    color: #A7A7A7;
    border: 0px solid #5F5F5F;
}

QFrame, QLabel, QToolTip {
    background: #424242;
    color: #B0B0B0;
    border: 0px solid #5A5A5A;
    border-radius: 0px;
    padding: 0px;
}

QFrame {
    background: #3D3D3D;
    padding: 3px;
}

QLabel {
    border: 1px;
    padding: 1px;
}

QToolTip {
    background: #4A4A4A;
    color: #D0D0D0;
    border: 1px solid #666666;
    padding: 4px 6px;
}

QLineEdit {
    background-color: #2D2D2D;
    color: #CFCFCF;
    selection-color: black;
    selection-background-color: --highlight;
    border-radius: 0px;
    border: 1px solid #555555;
    padding: 2px 2px;
}

QTextEdit {
    background-color: #171717;
    color: #CFCFCF;
    padding: 0px 0px;
    selection-color: white;
    selection-background-color: --highlight;
}

QPushButton {
    background-color: #5B5B5B;
    color: #EFEFEF;
    padding: 1px 1px;
    border-radius: 2px;
}

QPushButton:pressed {
    color: white;
    background-color: black;
}

QPushButton:checked {
    color: black;
    background-color: --highlight;
}

QPushButton:hover {
    color: white;
    background-color: #6C6C6C;
}

QPushButton:checked:hover {
    color: grey;
    background-color: --highlight;
}

QSpinBox {
    background: --highlight;
    color: black;
    border-radius: 0px;
    border: 1px solid #555555;
    padding: 1px 3px;
}

QDoubleSpinBox {
    background: --highlight;
    color: black;
    border-radius: 0px;
    border: 1px solid #555555;
    padding: 1px 3px;
}

QGroupBox {
    background-color: #5D5D5D;
    border: 0px;
}

QCheckBox {
    background: #444444;
    border: 0px;
    spacing: 0px;
}

QCheckBox::indicator {
    background-color: --highlight;
    border-radius: 3px;
    width: 13px;
    height: 13px;
}

QCheckBox::indicator:checked {
    image: url(--icon_path/check.png);
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QListView {
    background-color: #383838;
    alternate-background-color: #353535;
}

QTreeView {
    background-color: #383838;
    alternate-background-color: #353535;
    show-decoration-selected: 1;
}

QTreeView::item:hover {
    background-color: #494949;
}

QTreeView::item:selected {
    color: black;
    background: --highlight;
}

QTreeView::item:selected:active {
    background: --highlight;
    color: black;
}

QTreeView::item:selected:!active {
    background: --highlight;
    color: black;
}

QTreeView::branch:selected:active {
    background-color: --highlight;
}

QTreeView::branch:selected:!active {
    background-color: --highlight;
}

QTreeWidget::indicator:unchecked {
    image: url(--icon_path/box_off.png);
}

QTreeWidget::indicator:checked {
    image: url(--icon_path/box_on.png);
}

ProcessTreeWidget::indicator:unchecked {
    image: url(--icon_path/minus_alt.png);
}

ProcessTreeWidget::indicator:checked {
    image: url(--icon_path/plus.png);
}

/* ========== Compact Tabs ========== */

QTabWidget::pane {
    border-top: 1px solid #3A3A3A;
    background: #3D3D3D;
}

QTabWidget::tab-bar {
    left: 3px;
}

QTabBar {
    border: 0px;
    padding-top: 3px;
    background: transparent;
}

QTabBar::tab {
    background-color: #2F2F2F;
    color: #B0B0B0;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    min-width: 12ex;
    padding: 3px 9px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:hover {
    background-color: #3A3A3A;
    color: #E0E0E0;
    border-color: #4A4A4A;
}

QTabBar::tab:selected {
    /* Compact fade from the left */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 --darkhighlight,
        stop:0.28 --darkhighlight,
        stop:0.55 #2F2F2F,
        stop:1 #2F2F2F
    );
    color: #B0B0B0;
    border: 1px solid #3A3A3A;
    border-top: 3px solid --highlight;   /* no green line */
    border-bottom: 0px solid;   /* no green line */    
    margin-top: 2px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* ========== End Tabs ========== */

QAbstractScrollArea {
    border-radius: 2px;
    background-color: #303030;
}

QAbstractScrollArea::corner {
    border: none;
    background-color: transparent;
}

QScrollBar {
    border: none;
    background-color: transparent;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: --highlightdark;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: --highlight;
}

QScrollBar:vertical {
    background-color: #303030;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
    border-radius: 3px;
    margin: 0px 3px;
}

QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
}

QScrollBar::add-line:vertical {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    background-color: #303030;
    height: 14px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
    border-radius: 3px;
    margin: 3px 0px;
}

QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

QScrollBar::add-line:horizontal {
    height: 0px;
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QPlainTextEdit {
    background-color: #202020;
}

QMenu {
    background-color: #5A5A5A;
    border: 1px solid #333333;
    color: #D0D0D0;
    border-radius: 3px;
    padding: 2px;
}

QMenu::item {
    padding: 3px 8px;
    background-color: transparent;
    color: #E0E0E0;
}

QMenu::item:hover {
    background-color: #6A6A6A;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: --highlight;
    color: #000000;
    border-radius: 2px;
}

QMenu::separator {
    height: 1px;
    background-color: #4A4A4A;
    margin: 2px 0;
}

ProcessOptionsWidget {
    background-color: #606060;
}

ProcessOptionGroup QLabel {
    border: 1px;
    padding: 1px;
    background-color: #606060;
}

ProcessOptionGroup QCheckBox {
    border: 0px;
    padding: 0px;
    background-color: #606060;
}

ProcessOptionGroup OptionGroup {
    background-color: #4A4A4A;
}

ProcessOptionGroup OptionGroup QLabel {
    background-color: #4A4A4A;
}

ProcessOptionGroup OptionGroup QCheckBox {
    background: #4A4A4A;
}

ProcessOptionGroup OptionGroup OptionGroup {
    background-color: #3A3A3A;
}

ProcessOptionGroup OptionGroup OptionGroup QLabel {
    background-color: #3A3A3A;
}

ProcessOptionGroup OptionGroup OptionGroup QCheckBox {
    background: #3A3A3A;
}

ProcessOptionGroup OptionGroup OptionGroup OptionGroup {
    background-color: #2F2F2F;
}

ProcessOptionGroup OptionGroup OptionGroup OptionGroup QLabel {
    background-color: #2F2F2F;
}

ProcessOptionGroup OptionGroup OptionGroup OptionGroup QCheckBox {
    background: #2F2F2F;
}